                "path": "news/2019-3-2",
                "baseUrl": "https://orchidhq.github.io/Orchid",
                "fileName": "one-love",
                "extension": "html",
                "usePrettyUrl": true,
                "link": "https://orchidhq.github.io/Orchid/news/2019-3-2/one-love"
