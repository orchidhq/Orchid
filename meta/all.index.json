                    "previous": {
                      "path": "wiki/user-manual",
                      "baseUrl": "https://orchidhq.github.io/Orchid",
                      "fileName": "getting-started",
                      "extension": "html",
                      "usePrettyUrl": true,
                      "link": "https://orchidhq.github.io/Orchid/wiki/user-manual/getting-started"
